
<!DOCTYPE html>
<html>
<head>
    <title>Sweet Delights Bakery</title>

    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        body {
            font-family: Arial, sans-serif;
            background-color: #fff8f0;
            color: #4b2920;
        }

        /* Navigation */
        header {
            background-color: #6b3028;
            color: white;
            padding: 20px;
            text-align: center;
        }

        header h1 {
            font-size: 35px;
            margin-bottom: 10px;
        }

        nav {
            background-color: #e8a47c;
            padding: 15px;
            text-align: center;
        }

        nav a {
            color: #4b2920;
            text-decoration: none;
            margin: 15px;
            font-weight: bold;
        }

        /* Banner */
        .banner {
            background: linear-gradient(
                rgba(0,0,0,0.3),
                rgba(0,0,0,0.3)
            ), url("https://images.unsplash.com/photo-1578985545062-69928b1d9587");
            background-size: cover;
            background-position: center;
            height: 350px;
            display: flex;
            flex-direction: column;
            justify-content: center;
            align-items: center;
            color: white;
            text-align: center;
        }

        .banner h2 {
            font-size: 42px;
            margin-bottom: 15px;
        }

        .banner p {
            font-size: 20px;
        }

        /* Sections */
        section {
            padding: 40px 25px;
            text-align: center;
        }

        section h2 {
            color: #8b4235;
            margin-bottom: 25px;
            font-size: 30px;
        }

        /* Product Grid */
        .products {
            display: flex;
            flex-wrap: wrap;
            justify-content: center;
            gap: 25px;
        }

        .card {
            background-color: white;
            width: 250px;
            border-radius: 12px;
            overflow: hidden;
            box-shadow: 0 3px 10px #d8b9a8;
            padding-bottom: 18px;
            transition: transform 0.3s;
        }

        .card:hover {
            transform: translateY(-8px);
        }

        .card img {
            width: 100%;
            height: 180px;
            object-fit: cover;
        }

        .card h3 {
            margin: 12px;
            color: #7b382d;
        }

        .card p {
            margin: 8px;
        }

        .price {
            color: #b34c35;
            font-weight: bold;
            font-size: 19px;
        }

        button {
            background-color: #9b4938;
            color: white;
            border: none;
            padding: 10px 20px;
            border-radius: 5px;
            cursor: pointer;
            margin-top: 10px;
        }

        button:hover {
            background-color: #64291f;
        }

        /* Offers */
        .offers {
            background-color: #f5d4bd;
            padding: 35px;
        }

        .offers h2 {
            color: #79392d;
        }

        .offers p {
            font-size: 19px;
            margin: 12px;
        }

        /* Gallery */
        .gallery {
            display: flex;
            flex-wrap: wrap;
            justify-content: center;
            gap: 15px;
        }

        .gallery img {
            width: 220px;
            height: 190px;
            object-fit: cover;
            border-radius: 12px;
        }

        /* Contact */
        .contact {
            background-color: #6b3028;
            color: white;
        }

        .contact h2 {
            color: #ffcfad;
        }

        .contact p {
            margin: 12px;
            font-size: 17px;
        }

        footer {
            background-color: #3d211c;
            color: white;
            text-align: center;
            padding: 15px;
        }

        /* Responsive */
        @media(max-width: 600px) {
            nav a {
                display: inline-block;
                margin: 8px;
            }

            .banner h2 {
                font-size: 30px;
            }

            .card {
                width: 90%;
            }
        }

    </style>
</head>

<body>

    <!-- Header -->
    <header>
        <h1> Sweet Delights Bakery </h1>
        <p>Freshly Baked Happiness Every Day!</p>
    </header>

    <!-- Navigation -->
    <nav>
        <a href="#home">Home</a>
        <a href="#cakes">Cakes</a>
        <a href="#pastries">Pastries</a>
        <a href="#cookies">Cookies</a>
        <a href="#gallery">Gallery</a>
        <a href="#contact">Contact</a>
    </nav>

    <!-- Banner -->
    <div class="banner" id="home">
        <h2>Welcome to Sweet Delights!</h2>
        <p>Delicious Cakes, Pastries and Cookies</p>
        <button onclick="location.href='#cakes'">Explore Products</button>
    </div>

    <!-- Cakes -->
    <section id="cakes">
        <h2>Our Special Cakes 🎂</h2>

        <div class="products">

            <div class="card">
                <img src="https://images.unsplash.com/photo-1578985545062-69928b1d9587">
                <h3>Chocolate Cake</h3>
                <p>Rich and creamy chocolate cake.</p>
                <p class="price">₹650</p>
                <button>Order Now</button>
            </div>

            <div class="card">
                <img src="https://images.unsplash.com/photo-1565958011703-44f9829ba187">
                <h3>Strawberry Cake</h3>
                <p>Fresh strawberry cream cake.</p>
                <p class="price">₹750</p>
                <button>Order Now</button>
            </div>

            <div class="card">
                <img src="https://images.unsplash.com/photo-1464349095431-e9a21285b5f3">
                <h3>Vanilla Cake</h3>
                <p>Soft and delicious vanilla cake.</p>
                <p class="price">₹550</p>
                <button>Order Now</button>
            </div>

        </div>
    </section>

    <!-- Pastries -->
    <section id="pastries">
        <h2>Delicious Pastries 🧁</h2>

        <div class="products">

            <div class="card">
                <img src="https://images.unsplash.com/photo-1488477181946-6428a0291777">
                <h3>Chocolate Pastry</h3>
                <p>Soft chocolate layered pastry.</p>
                <p class="price">₹90</p>
                <button>Order Now</button>
            </div>

            <div class="card">
                <img src="https://images.unsplash.com/photo-1551024506-0bccd828d307">
                <h3>Strawberry Pastry</h3>
                <p>Sweet strawberry cream pastry.</p>
                <p class="price">₹100</p>
                <button>Order Now</button>
            </div>

        </div>
    </section>

    <!-- Cookies -->
    <section id="cookies">
        <h2>Crunchy Cookies 🍪</h2>

        <div class="products">

            <div class="card">
                <img src="https://images.unsplash.com/photo-1499636136210-6f4ee915583e">
                <h3>Chocolate Cookies</h3>
                <p>Chocolate chip crunchy cookies.</p>
                <p class="price">₹150</p>
                <button>Order Now</button>
            </div>

            <div class="card">
                <img src="https://images.unsplash.com/photo-1558961363-fa8fdf82db35">
                <h3>Butter Cookies</h3>
                <p>Fresh and crispy butter cookies.</p>
                <p class="price">₹120</p>
                <button>Order Now</button>
            </div>

        </div>
    </section>

    <!-- Custom Cakes -->
    <section>
        <h2>Custom Cake Designs 🎀</h2>

        <div class="products">

            <div class="card">
                <img src="https://images.unsplash.com/photo-1535254973040-607b474cb50d">
                <h3>Birthday Cakes</h3>
                <p>Beautiful cakes for birthdays.</p>
                <p class="price">Starting ₹900</p>
                <button>Customize</button>
            </div>

            <div class="card">
                <img src="https://images.unsplash.com/photo-1519741497674-611481863552">
                <h3>Wedding Cakes</h3>
                <p>Elegant cakes for special occasions.</p>
                <p class="price">Starting ₹2500</p>
                <button>Customize</button>
            </div>

        </div>
    </section>

    <!-- Seasonal Offers -->
    <section class="offers">
        <h2>🎉 Seasonal Special Offers 🎉</h2>
        <p>Buy 2 Pastries and Get 1 Free!</p>
        <p>Get 20% OFF on Birthday Cakes.</p>
        <p>Special Christmas Cake Collection Available!</p>
    </section>

    <!-- Gallery -->
    <section id="gallery">
        <h2>Our Bakery Gallery 📸</h2>

        <div class="gallery">
            <img src="https://images.unsplash.com/photo-1578985545062-69928b1d9587">
            <img src="https://images.unsplash.com/photo-1499636136210-6f4ee915583e">
            <img src="https://images.unsplash.com/photo-1565958011703-44f9829ba187">
            <img src="https://images.unsplash.com/photo-1551024506-0bccd828d307">
        </div>
    </section>

    <!-- Contact -->
    <section class="contact" id="contact">
        <h2>Contact Us</h2>
        <p>📍 Address: Sweet Delights Bakery, Vijayawada</p>
        <p>📞 Phone: +91 98765 43210</p>
        <p>📧 Email: sweetdelights@gmail.com</p>
        <p>🕒 Opening Hours: 9:00 AM - 9:00 PM</p>
    </section>

    <!-- Footer -->
    <footer>
        <p>© 2026 Sweet Delights Bakery | Made with Love ❤️</p>
    </footer>

</body>
</html>

