
<!DOCTYPE html>
<html>
<head>
    <title>Project Management Dashboard</title>

    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        body {
            font-family: Arial, sans-serif;
            background: #f3f5fa;
            color: #333;
        }

        header {
            background: #252b48;
            color: white;
            padding: 22px 35px;
            display: flex;
            justify-content: space-between;
            align-items: center;
        }

        header h1 {
            font-size: 25px;
        }

        .profile {
            background: #6574cd;
            padding: 10px 15px;
            border-radius: 20px;
        }

        .container {
            padding: 25px 35px;
        }

        .welcome {
            margin-bottom: 25px;
        }

        .welcome h2 {
            margin-bottom: 8px;
        }

        /* Project Summary Grid */

        .summary {
            display: grid;
            grid-template-columns: repeat(4, 1fr);
            gap: 20px;
            margin-bottom: 30px;
        }

        .summary-card {
            background: white;
            padding: 22px;
            border-radius: 12px;
            box-shadow: 0 3px 10px #ddd;
        }

        .summary-card h3 {
            color: #777;
            font-size: 14px;
            margin-bottom: 12px;
        }

        .summary-card p {
            font-size: 27px;
            font-weight: bold;
            color: #3949ab;
        }

        /* Team Members */

        .team {
            background: white;
            padding: 20px;
            border-radius: 12px;
            margin-bottom: 30px;
        }

        .team h2 {
            margin-bottom: 18px;
        }

        .members {
            display: flex;
            gap: 25px;
            flex-wrap: wrap;
        }

        .member {
            display: flex;
            align-items: center;
            gap: 10px;
        }

        .avatar {
            width: 40px;
            height: 40px;
            border-radius: 50%;
            background: #6574cd;
            color: white;
            display: flex;
            justify-content: center;
            align-items: center;
            font-weight: bold;
        }

        /* Kanban Board */

        .board-title {
            margin-bottom: 18px;
        }

        .kanban {
            display: grid;
            grid-template-columns: repeat(3, 1fr);
            gap: 20px;
        }

        .column {
            background: #e8ebf4;
            padding: 18px;
            border-radius: 12px;
            min-height: 350px;
        }

        .column h3 {
            margin-bottom: 18px;
            color: #252b48;
        }

        /* Task Cards */

        .task {
            background: white;
            padding: 18px;
            margin-bottom: 15px;
            border-radius: 10px;
            box-shadow: 0 2px 6px #ddd;
        }

        .task h4 {
            margin-bottom: 10px;
        }

        .task p {
            font-size: 13px;
            color: #777;
            margin-bottom: 12px;
        }

        .priority {
            display: inline-block;
            padding: 5px 10px;
            border-radius: 15px;
            font-size: 11px;
            margin-bottom: 12px;
        }

        .high {
            background: #ffe0e0;
            color: #d32f2f;
        }

        .medium {
            background: #fff0cc;
            color: #b77900;
        }

        .low {
            background: #d9f5e4;
            color: #16834a;
        }

        .progress {
            background: #eee;
            height: 8px;
            border-radius: 10px;
            margin: 10px 0;
        }

        .progress-bar {
            height: 8px;
            background: #6574cd;
            border-radius: 10px;
        }

        .task-footer {
            display: flex;
            justify-content: space-between;
            font-size: 12px;
            color: #777;
            margin-top: 12px;
        }

        footer {
            text-align: center;
            padding: 20px;
            color: #777;
        }

        /* Responsive Layout */

        @media (max-width: 800px) {
            .summary {
                grid-template-columns: repeat(2, 1fr);
            }

            .kanban {
                grid-template-columns: 1fr;
            }
        }

        @media (max-width: 500px) {
            .summary {
                grid-template-columns: 1fr;
            }

            header {
                padding: 18px;
            }

            .container {
                padding: 18px;
            }
        }
    </style>
</head>

<body>

<header>
    <h1>Project Management</h1>
    <div class="profile">Pallavi 👤</div>
</header>

<div class="container">

    <div class="welcome">
        <h2>Welcome Back, Pallavi!</h2>
        <p>Here is your project overview.</p>
    </div>

    <!-- Project Summary -->

    <div class="summary">

        <div class="summary-card">
            <h3>Total Projects</h3>
            <p>12</p>
        </div>

        <div class="summary-card">
            <h3>Tasks Completed</h3>
            <p>28</p>
        </div>

        <div class="summary-card">
            <h3>In Progress</h3>
            <p>08</p>
        </div>

        <div class="summary-card">
            <h3>Pending Tasks</h3>
            <p>05</p>
        </div>

    </div>

    <!-- Team Members -->

    <div class="team">
        <h2>Team Members</h2>

        <div class="members">

            <div class="member">
                <div class="avatar">P</div>
                <span>Pallavi</span>
            </div>

            <div class="member">
                <div class="avatar">S</div>
                <span>Sanjana</span>
            </div>

            <div class="member">
                <div class="avatar">L</div>
                <span>Laasya</span>
            </div>

            <div class="member">
                <div class="avatar">R</div>
                <span>Rahul</span>
            </div>

        </div>
    </div>

    <!-- Kanban Board -->

    <h2 class="board-title">Project Tasks</h2>

    <div class="kanban">

        <!-- To Do -->

        <div class="column">
            <h3>📌 To Do</h3>

            <div class="task">
                <h4>Website Design</h4>
                <p>Create homepage layout and design.</p>
                <span class="priority high">High Priority</span>
                <div class="task-footer">
                    <span>👤 Pallavi</span>
                    <span>📅 Nov 15</span>
                </div>
            </div>

            <div class="task">
                <h4>Research Work</h4>
                <p>Collect project-related information.</p>
                <span class="priority medium">Medium Priority</span>
                <div class="task-footer">
                    <span>👤 Sanjana</span>
                    <span>📅 Nov 18</span>
                </div>
            </div>

        </div>

        <!-- In Progress -->

        <div class="column">
            <h3>⚡ In Progress</h3>

            <div class="task">
                <h4>Frontend Development</h4>
                <p>Develop website using HTML and CSS.</p>
                <span class="priority high">High Priority</span>

                <div class="progress">
                    <div class="progress-bar"
                         style="width: 65%;"></div>
                </div>

                <p>65% Completed</p>

                <div class="task-footer">
                    <span>👤 Laasya</span>
                    <span>📅 Nov 20</span>
                </div>
            </div>

            <div class="task">
                <h4>Content Writing</h4>
                <p>Prepare content for the website.</p>
                <span class="priority low">Low Priority</span>

                <div class="progress">
                    <div class="progress-bar"
                         style="width: 40%;"></div>
                </div>

                <p>40% Completed</p>

                <div class="task-footer">
                    <span>👤 Rahul</span>
                    <span>📅 Nov 22</span>
                </div>
            </div>

        </div>

        <!-- Completed -->

        <div class="column">
            <h3>✅ Completed</h3>

            <div class="task">
                <h4>Project Planning</h4>
                <p>Prepare project requirements.</p>
                <span class="priority medium">Medium Priority</span>

                <div class="progress">
                    <div class="progress-bar"
                         style="width: 100%;"></div>
                </div>

                <p>100% Completed</p>

                <div class="task-footer">
                    <span>👤 Pallavi</span>
                    <span>📅 Nov 10</span>
                </div>
            </div>

            <div class="task">
                <h4>Team Meeting</h4>
                <p>Discuss project ideas and workflow.</p>
                <span class="priority low">Low Priority</span>

                <div class="progress">
                    <div class="progress-bar"
                         style="width: 100%;"></div>
                </div>

                <p>100% Completed</p>

                <div class="task-footer">
                    <span>👤 Sanjana</span>
                    <span>📅 Nov 11</span>
                </div>
            </div>

        </div>

    </div>

</div>

<footer>
    © 2026 Project Management Dashboard | Designed using HTML and CSS
</footer>

</body>
</html>

